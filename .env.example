# aihubmix OpenAI-compatible API
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://aihubmix.com/v1

# 模型名称
# 主模型: doubao-seed-1-8-251228
# Judge模型: zai-glm-4.7 (用于 LLM-as-judge 场景)

# ============================================================
# Token Pricing Configuration
# ============================================================
# Pricing preset for weighted token cost calculation
# Options: default, openai, anthropic, google, chinese
# - default: 5× output, 0.1× cache read, 1.25× cache write (industry average)
# - openai: 6× output (newer OpenAI models)
# - anthropic: 5× output (Anthropic Claude)
# - google: 8× output (Google Gemini)
# - chinese: 1.5× output (DeepSeek, Qwen)
TOKEN_PRICING_PRESET=default

# Custom pricing weights (overrides preset)
# TOKEN_PRICING_INPUT_WEIGHT=1.0
# TOKEN_PRICING_OUTPUT_WEIGHT=5.0
# TOKEN_PRICING_CACHE_READ_WEIGHT=0.1
# TOKEN_PRICING_CACHE_WRITE_WEIGHT=1.25

# Show costs in output (default: true)
# TOKEN_STATS_SHOW_COSTS=true
